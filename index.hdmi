                    <i class="fa-solid fa-heart text-amber-300"></i> 희망 강좌 목록
                    <span id="wishlistBadgeCount" class="bg-white/20 text-white text-xs px-1.5 py-0.5 rounded-full">0</span>
                </button>
                <button onclick="switchTab('allCourses')" id="tab-allCourses" class="flex-1 min-w-[120px] py-2.5 px-4 rounded-lg font-bold text-sm transition flex items-center justify-center gap-2 text-gray-600 hover:bg-gray-100">
                    <i class="fa-solid fa-book-open"></i> 개설 강좌 목록
                </button>
                <button onclick="switchTab('timetable')" id="tab-timetable" class="flex-1 min-w-[120px] py-2.5 px-4 rounded-lg font-bold text-sm transition flex items-center justify-center gap-2 text-gray-600 hover:bg-gray-100">
