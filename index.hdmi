    </main>

    <!-- Custom Modal Popup -->
    <div id="customModal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-xl shadow-2xl max-w-sm w-full p-6 text-center transform transition-all">
            <i id="modalIcon" class="fa-solid fa-circle-exclamation text-amber-500 text-3xl mb-3"></i>
            <h3 id="modalTitle" class="text-lg font-bold text-gray-800 mb-2">알림</h3>
            <p id="modalMessage" class="text-xs text-gray-600 mb-6 leading-relaxed">경고 메시지입니다.</p>
            <button onclick="closeModal()" class="w-full py-2.5 bg-kuGreen hover:bg-kuGreen-dark text-white font-bold text-xs rounded-lg transition">
                확인
            </button>
        </div>
    </div>

    <!-- Footer -->
    <footer class="bg-gray-100 border-t border-gray-200 py-4 mt-auto text-center text-xs text-gray-500">
        <p>© 2026 건국대학교 KONKUK UNIVERSITY. 마일리지 할당 수강신청 시뮬레이터</p>
    </footer>

    <script>
        // --- AUTHENTICATION & INITIALIZATION ---
        function loadPresetStudent() {
            const selectedId = document.getElementById('presetSelect').value;
            if (selectedId) {
                const found = STUDENTS.find(s => s.id === selectedId);
                if (found) {
                    document.getElementById('loginId').value = found.id;
                    document.getElementById('loginPass').value = '1234';
                }
            }
        }

        function handleLogin(e) {
            e.preventDefault();
            const inputId = document.getElementById('loginId').value.trim();
            const inputPass = document.getElementById('loginPass').value.trim();

            const student = STUDENTS.find(s => s.id === inputId);
            if (!student || student.pass !== inputPass) {
                showAlert('로그인 실패', '학번 또는 비밀번호가 올바르지 않습니다.');
                return;
            }

            currentUser = student;
            wishlist = []; // Reset wishlist on login
            isFinalized = false;
            finalResults = null;

            // UI Header Updates
            document.getElementById('userDisplayName').innerText = currentUser.name;
            document.getElementById('userDisplayDept').innerText = currentUser.dept;
            document.getElementById('userDisplayGrade').innerText = currentUser.grade;
            document.getElementById('catalogUserDept').innerText = currentUser.dept;

            if (currentUser.isEarlyGrad) {
                document.getElementById('earlyGradBadge').classList.remove('hidden');
            } else {
                document.getElementById('earlyGradBadge').classList.add('hidden');
            }

            document.getElementById('loginSection').classList.add('hidden');
            document.getElementById('headerUserInfo').classList.remove('hidden');
            document.getElementById('appDashboard').classList.remove('hidden');

            startTimer();
            updateWalletUI();
            renderWishlist();
            renderAllCourses();
            renderTimetable();
        }

        function logout() {
            currentUser = null;
            clearInterval(timerInterval);
            document.getElementById('loginSection').classList.remove('hidden');
            document.getElementById('headerUserInfo').classList.add('hidden');
            document.getElementById('appDashboard').classList.add('hidden');
        }

        // --- TIMER & BLIND LOGIC ---
        function startTimer() {
            if (timerInterval) clearInterval(timerInterval);
            timerInterval = setInterval(() => {
                if (timerSeconds > 0) {
                    timerSeconds--;
                    updateTimerDisplay();
                } else {
                    clearInterval(timerInterval);
                    finalizeRegistration(); // Auto finalize on time out
                }
            }, 1000);
            updateTimerDisplay();
        }

        function updateTimerDisplay() {
            const h = String(Math.floor(timerSeconds / 3600)).padStart(2, '0');
            const m = String(Math.floor((timerSeconds % 3600) / 60)).padStart(2, '0');
            const s = String(timerSeconds % 60).padStart(2, '0');
            document.getElementById('countdownTimer').innerText = `${h}:${m}:${s}`;

            // Check Blind status (<= 1 hour = 3600s)
            const isBlind = timerSeconds <= 3600;
            const blindNotice = document.getElementById('blindNoticeTag');
            if (isBlind) {
                blindNotice.classList.remove('hidden');
            } else {
                blindNotice.classList.add('hidden');
            }

            // Re-render wishlist cutoff statuses if blind status changes
            renderWishlist();
        }

        function skipTimerToOneHour() {
            timerSeconds = 59 * 60 + 59; // Jump to 59min 59sec
            updateTimerDisplay();
            showAlert('타임스킵', '수강신청 마감 1시간 전으로 이동했습니다. 예상 컷오프가 블라인드 처리됩니다.', 'fa-clock text-amber-500');
        }

        // --- TAB SWITCHING ---
        function switchTab(tabName) {
            activeTab = tabName;
            const tabs = ['wishlist', 'allCourses', 'timetable', 'history', 'result'];
            tabs.forEach(t => {
                const btn = document.getElementById(`tab-${t}`);
                const content = document.getElementById(`content-${t}`);
                if (t === tabName) {
                    btn.className = "flex-1 min-w-[120px] py-2.5 px-4 rounded-lg font-bold text-sm transition flex items-center justify-center gap-2 bg-kuGreen text-white shadow";
                    content.classList.remove('hidden');
                } else {
                    btn.className = "flex-1 min-w-[120px] py-2.5 px-4 rounded-lg font-bold text-sm transition flex items-center justify-center gap-2 text-gray-600 hover:bg-gray-100";
                    content.classList.add('hidden');
                }
            });

            if (tabName === 'timetable') renderTimetable();
            if (tabName === 'history') updateWalletUI();
        }

        // --- MILEAGE WALLET CALCULATIONS ---
        function getTotalMileage() {
            return currentUser ? currentUser.maxCredits * 100 : 0;
        }

        function getUsedMileage() {
            return wishlist.reduce((sum, item) => sum + (Number(item.mileage) || 0), 0);
        }

        function getRemainingMileage() {
            return getTotalMileage() - getUsedMileage();
        }

        function updateWalletUI() {
            const total = getTotalMileage();
            const used = getUsedMileage();
            const remaining = getRemainingMileage();

            document.getElementById('headerTotalMileage').innerText = total;
            document.getElementById('headerRemainingMileage').innerText = remaining;
            document.getElementById('wishlistRemainingWallet').innerText = remaining;

            document.getElementById('walletTotal').innerText = `${total} M`;
            document.getElementById('walletUsed').innerText = `${used} M`;
            document.getElementById('walletRemaining').innerText = `${remaining} M`;

            renderHistoryTable();
        }

        // --- TAB 2: COURSE CATALOG RENDER & RESTRICTIONS ---
        function renderAllCourses() {
            const category = document.getElementById('courseCategoryFilter').value;
            const tbody = document.getElementById('allCoursesTableBody');
            tbody.innerHTML = '';

            const filtered = ALL_COURSES.filter(c => {
                if (category === 'ALL') return true;
                if (category === '교양기초') return c.type === '교양기초';
                if (category === '교양소양') return c.type === '교양소양';
                if (category === '교양심화') return c.type === '교양심화';
                return c.dept === category;
            });

            filtered.forEach(course => {
                const isMajor = course.type === '전공';
                const isMyMajor = isMajor && course.dept === currentUser.dept;
                const isOtherMajor = isMajor && course.dept !== currentUser.dept;
                const isAlreadyInWishlist = wishlist.some(w => w.courseId === course.id);

                const tr = document.createElement('tr');
                tr.className = "hover:bg-gray-50 transition border-b border-gray-100";

                let actionButton = '';
                if (isOtherMajor) {
                    actionButton = `
                        <button disabled class="px-3 py-1.5 bg-gray-200 text-gray-400 rounded text-xs font-bold cursor-not-allowed" title="타과 전공 수강은 제한됩니다.">
                            <i class="fa-solid fa-ban"></i> 타과전공 제한
                        </button>
                    `;
                } else if (isAlreadyInWishlist) {
                    actionButton = `
                        <button disabled class="px-3 py-1.5 bg-emerald-100 text-emerald-700 rounded text-xs font-bold">
                            <i class="fa-solid fa-check"></i> 담기 완료
                        </button>
                    `;
                } else {
                    actionButton = `
                        <button onclick="addToWishlist('${course.id}')" class="px-3 py-1.5 bg-kuGreen hover:bg-kuGreen-dark text-white rounded text-xs font-bold transition shadow-sm">
                            <i class="fa-solid fa-plus"></i> 담기
                        </button>
                    `;
                }

                tr.innerHTML = `
                    <td class="p-3 font-mono font-medium text-gray-500">${course.id}</td>
                    <td class="p-3">
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold ${isMajor ? 'bg-blue-100 text-blue-700' : 'bg-purple-100 text-purple-700'}">
                            ${course.type}
                        </span>
                    </td>
                    <td class="p-3 font-medium">${course.dept}</td>
                    <td class="p-3 font-bold text-gray-800">${course.name}</td>
                    <td class="p-3 text-gray-600">${course.professor}</td>
                    <td class="p-3 text-gray-500">${course.location}</td>
                    <td class="p-3 font-mono text-gray-600">${course.time}</td>
                    <td class="p-3 font-bold">${course.credit}학점</td>
                    <td class="p-3 text-gray-500">${course.maxCap}명</td>
                    <td class="p-3 text-center">${actionButton}</td>
                `;
                tbody.appendChild(tr);
            });
        }

        // --- WISHLIST MANAGEMENT & TIMETABLE OVERLAP CHECK ---
        function addToWishlist(courseId) {
            const courseToAdd = ALL_COURSES.find(c => c.id === courseId);
            if (!courseToAdd) return;

            // 1. Restriction Check: Major of other departments
            if (courseToAdd.type === '전공' && courseToAdd.dept !== currentUser.dept) {
                showAlert('수강 신청 불가', '타과 전공 과목은 희망 강좌로 담거나 마일리지 베팅을 할 수 없습니다.');
                return;
            }

            // 2. Timetable Overlap Check
            const newSlots = parseCourseTime(courseToAdd.time);
            for (let item of wishlist) {
                const existingCourse = ALL_COURSES.find(c => c.id === item.courseId);
                if (existingCourse) {
                    const existingSlots = parseCourseTime(existingCourse.time);
                    if (isTimeOverlapping(newSlots, existingSlots)) {
                        showAlert(
                            '시간표 중복 경고', 
                            `강좌 담을 때 시간표가 겹치면 선택할 수 없습니다!\n\n[겹치는 과목]: ${existingCourse.name} (${existingCourse.time})`, 
                            'fa-triangle-exclamation text-red-500'
                        );
                        return; // Block adding course
                    }
                }
            }

            // Default betting 0 M when added
            wishlist.push({ courseId: courseId, mileage: 0 });
            renderWishlist();
            renderAllCourses();
            updateWalletUI();
            showAlert('담기 성공', `[${courseToAdd.name}] 과목이 희망 강좌 목록에 추가되었습니다.`, 'fa-circle-check text-emerald-500');
        }

        function removeFromWishlist(courseId) {
            wishlist = wishlist.filter(w => w.courseId !== courseId);
            renderWishlist();
            renderAllCourses();
            updateWalletUI();
        }

        // --- TAB 1: WISHLIST & BETTING RENDERER ---
        function renderWishlist() {
            const tbody = document.getElementById('wishlistTableBody');
            const emptyState = document.getElementById('wishlistEmptyState');
            tbody.innerHTML = '';

            document.getElementById('wishlistBadgeCount').innerText = wishlist.length;

            if (wishlist.length === 0) {
                emptyState.classList.remove('hidden');
                return;
            } else {
                emptyState.classList.add('hidden');
            }

            const isBlind = timerSeconds <= 3600;

            wishlist.forEach(item => {
                const course = ALL_COURSES.find(c => c.id === item.courseId);
                if (!course) return;

                const myBet = Number(item.mileage) || 0;
                const cutoff = course.baseCutoff;

                // Cutoff Status Calculation
                let statusBadge = '';
                if (isBlind) {
                    statusBadge = `
                        <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-gray-200 text-gray-600 border border-gray-300">
                            <i class="fa-solid fa-eye-slash"></i> ??? (블라인드)
                        </span>
                    `;
                } else {
                    if (myBet > cutoff) {
                        statusBadge = `
                            <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 border border-emerald-300 flex items-center gap-1 w-fit">
                                <i class="fa-solid fa-circle-check text-emerald-600"></i> 안정권 (${cutoff}M)
                            </span>
                        `;
                    } else if (myBet === cutoff) {
                        statusBadge = `
                            <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-800 border border-amber-300 flex items-center gap-1 w-fit">
                                <i class="fa-solid fa-triangle-exclamation text-amber-600"></i> 커트라인 (${cutoff}M)
                            </span>
                        `;
                    } else {
                        statusBadge = `
                            <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-red-100 text-red-800 border border-red-300 flex items-center gap-1 w-fit">
                                <i class="fa-solid fa-circle-xmark text-red-600"></i> 탈락권 (${cutoff}M)
                            </span>
                        `;
                    }
                }

                const tr = document.createElement('tr');
                tr.className = "hover:bg-gray-50 transition border-b border-gray-100";
                tr.innerHTML = `
                    <td class="p-3">
                        <span class="px-2 py-0.5 rounded text-[10px] font-bold ${course.type === '전공' ? 'bg-blue-100 text-blue-700' : 'bg-purple-100 text-purple-700'}">
                            ${course.type}
                        </span>
                    </td>
                    <td class="p-3">
                        <strong class="text-gray-800">${course.name}</strong>
                        <div class="text-[10px] text-gray-400 font-mono">${course.id}</div>
                    </td>
                    <td class="p-3 text-gray-600">${course.professor}<br><span class="text-[11px] text-gray-400">${course.location}</span></td>
                    <td class="p-3 font-mono text-gray-600 text-xs">${course.time}</td>
                    <td class="p-3 font-bold text-gray-700">${course.credit}학점</td>
                    <td class="p-3 text-gray-500">${course.maxCap}명</td>
                    <td class="p-3">${statusBadge}</td>
                    <td class="p-3">
                        <div class="flex items-center gap-1">
                            <input 
                                type="number" 
                                min="0" 
                                max="800" 
                                value="${item.mileage}" 
                                oninput="handleBettingInput('${course.id}', this.value)"
                                class="w-24 p-1.5 border border-gray-300 rounded font-bold text-right text-kuGreen focus:ring-2 focus:ring-kuGreen focus:outline-none text-xs"
                            />
                            <span class="font-bold text-gray-500 text-xs">M</span>
                            <div class="flex flex-col gap-0.5 ml-1">
                                <button onclick="quickAdjustBetting('${course.id}', 50)" class="px-1.5 py-0.5 bg-gray-200 hover:bg-gray-300 rounded text-[10px] font-bold text-gray-700">+50</button>
                                <button onclick="quickAdjustBetting('${course.id}', -50)" class="px-1.5 py-0.5 bg-gray-200 hover:bg-gray-300 rounded text-[10px] font-bold text-gray-700">-50</button>
                            </div>
                        </div>
                    </td>
                    <td class="p-3 text-center">
                        <button onclick="removeFromWishlist('${course.id}')" class="text-red-500 hover:text-red-700 p-1.5 rounded hover:bg-red-50 transition" title="삭제">
                            <i class="fa-solid fa-trash-can"></i>
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function handleBettingInput(courseId, valStr) {
            let val = parseInt(valStr, 10);
            if (isNaN(val) || val < 0) val = 0;

            // Maximum betting limit per course = 800M
            if (val > 800) {
                showAlert('할당 한도 초과', '한 과목에 최대로 할당할 수 있는 마일리지는 800 마일리지입니다.');
                val = 800;
            }

            const item = wishlist.find(w => w.courseId === courseId);
            if (!item) return;

            const oldMileage = item.mileage;
            item.mileage = val;

            // Wallet Overdraft Check
            if (getRemainingMileage() < 0) {
                showAlert('마일리지 부족', '최대 소지 마일리지를 초과하여 할당할 수 없습니다.');
                item.mileage = oldMileage; // revert
            }

            updateWalletUI();
            renderWishlist();
        }

        function quickAdjustBetting(courseId, delta) {
            const item = wishlist.find(w => w.courseId === courseId);
            if (!item) return;
            const current = Number(item.mileage) || 0;
            handleBettingInput(courseId, current + delta);
        }

        // --- TAB 3: TIMETABLE RENDERER ---
        function renderTimetable() {
            const grid = document.getElementById('timetableGrid');
            grid.innerHTML = '';

            const days = ['월', '화', '수', '목', '금'];
            const timeslots = [];

            // 09:00 to 18:00 (Every 30 mins)
            for (let h = 9; h < 18; h++) {
                timeslots.push(`${String(h).padStart(2, '0')}:00`);
                timeslots.push(`${String(h).padStart(2, '0')}:30`);
            }

            // Map wishlist courses to slots
            const occupiedMap = {}; // key: "월_09:00" -> course object

            wishlist.forEach(item => {
                const course = ALL_COURSES.find(c => c.id === item.courseId);
                if (course) {
                    const slots = parseCourseTime(course.time);
                    slots.forEach(s => {
                        const startMin = timeToMinutes(s.start);
                        const endMin = timeToMinutes(s.end);

                        timeslots.forEach(tStr => {
                            const tMin = timeToMinutes(tStr);
                            if (tMin >= startMin && tMin < endMin) {
                                occupiedMap[`${s.day}_${tStr}`] = course;
                            }
                        });
                    });
                }
            });

            const colors = ['bg-emerald-100 text-emerald-900 border-emerald-300', 'bg-blue-100 text-blue-900 border-blue-300', 'bg-amber-100 text-amber-900 border-amber-300', 'bg-purple-100 text-purple-900 border-purple-300', 'bg-pink-100 text-pink-900 border-pink-300'];

            timeslots.forEach((tStr, idx) => {
                const row = document.createElement('div');
                row.className = "time-table-grid min-h-[36px] items-center border-b border-gray-100";

                // Time label column
                const timeCell = document.createElement('div');
                timeCell.className = "text-[10px] text-gray-400 font-mono text-center bg-gray-50 py-1 h-full flex items-center justify-center border-r border-gray-200";
                timeCell.innerText = tStr;
                row.appendChild(timeCell);

                // Day columns
                days.forEach(day => {
                    const dayCell = document.createElement('div');
                    dayCell.className = "p-0.5 border-r border-gray-100 h-full flex items-center justify-center text-[10px]";

                    const matchedCourse = occupiedMap[`${day}_${tStr}`];
                    if (matchedCourse) {
                        const colorIdx = (matchedCourse.id.charCodeAt(0) + matchedCourse.id.charCodeAt(matchedCourse.id.length - 1)) % colors.length;
                        dayCell.innerHTML = `
                            <div class="w-full h-full p-1 rounded ${colors[colorIdx]} border text-center font-bold leading-tight truncate">
                                ${matchedCourse.name}
                            </div>
                        `;
                    }
                    row.appendChild(dayCell);
                });

                grid.appendChild(row);
            });
        }

        // --- TAB 4: ALLOCATION HISTORY RENDERER ---
        function renderHistoryTable() {
            const tbody = document.getElementById('allocationHistoryTableBody');
            tbody.innerHTML = '';

            if (wishlist.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="p-6 text-center text-gray-400 text-xs">할당된 마일리지 내역이 없습니다.</td></tr>`;
                return;
            }

            wishlist.forEach(item => {
                const course = ALL_COURSES.find(c => c.id === item.courseId);
                if (!course) return;

                const tr = document.createElement('tr');
                tr.className = "border-b border-gray-100 hover:bg-gray-50";
                tr.innerHTML = `
                    <td class="p-3 font-mono font-medium text-gray-500">${course.id}</td>
                    <td class="p-3"><span class="px-2 py-0.5 rounded text-[10px] font-bold ${course.type === '전공' ? 'bg-blue-100 text-blue-700' : 'bg-purple-100 text-purple-700'}">${course.type}</span></td>
                    <td class="p-3 font-bold text-gray-800">${course.name}</td>
                    <td class="p-3 text-gray-600">${course.professor}</td>
                    <td class="p-3">${course.credit}학점</td>
                    <td class="p-3 text-right font-bold text-kuGreen">${item.mileage} M</td>
                `;
                tbody.appendChild(tr);
            });
        }

        // --- FINAL REGISTRATION SIMULATION & ALGORITHM ---
        function finalizeRegistration() {
            isFinalized = true;

            // Simulated Competitor Applicants Generator
            // To create realistic cutoff competition for each course
            finalResults = wishlist.map(item => {
                const course = ALL_COURSES.find(c => c.id === item.courseId);
                const myBet = Number(item.mileage) || 0;

                // Simulate mock competitor pool
                const competitorCount = course.maxCap + Math.floor(Math.random() * 15); // Slightly over capacity
                const applicants = [];

                // 1. Add Current User to Applicant List
                applicants.push({
                    isMe: true,
                    name: currentUser.name,
                    dept: currentUser.dept,
                    grade: currentUser.grade,
                    isEarlyGrad: currentUser.isEarlyGrad,
                    mileage: myBet
                });

                // 2. Add Mock Competitors
                for (let i = 0; i < competitorCount; i++) {
                    const isMajorComp = course.type === '전공' ? (Math.random() < 0.8) : false;
                    const compGrade = Math.floor(Math.random() * 4) + 1;
                    const compEarlyGrad = compGrade === 3 ? (Math.random() < 0.1) : false;
                    
                    // Competitors bid around cutoff range
                    const compMileage = Math.max(0, Math.floor(course.baseCutoff + (Math.random() * 100 - 50)));

                    applicants.push({
                        isMe: false,
                        name: `학생${i+1}`,
                        dept: isMajorComp ? course.dept : '타학과',
                        grade: compGrade,
                        isEarlyGrad: compEarlyGrad,
                        mileage: compMileage
                    });
                }

                // 3. SORTING ALGORITHM BASED ON SPECIFIED PRIORITIES
                // Priority 1: Mileage (High to Low)
                // Priority 2: Major Student Preference (If Course is Major)
                // Priority 3: Grade (Higher grade = graduating imminent. Early Graduation = Highest priority)
                // Priority 4: Random Seed for ties
                applicants.sort((a, b) => {
                    // 1. Mileage
                    if (b.mileage !== a.mileage) {
                        return b.mileage - a.mileage;
                    }

                    // 2. Major Preference (Only for Major courses)
                    if (course.type === '전공') {
                        const aIsMajor = a.dept === course.dept;
                        const bIsMajor = b.dept === course.dept;
                        if (aIsMajor !== bIsMajor) {
                            return bIsMajor ? 1 : -1;
                        }
                    }

                    // 3. Grade / Early Grad (Early grad priority first, then Grade 4 -> 3 -> 2 -> 1)
                    if (a.isEarlyGrad !== b.isEarlyGrad) {
                        return b.isEarlyGrad ? 1 : -1;
                    }
                    if (b.grade !== a.grade) {
                        return b.grade - a.grade;
                    }

                    // 4. Random tie breaker
                    return Math.random() - 0.5;
                });

                // Determine cutoff and user success status
                const acceptedList = applicants.slice(0, course.maxCap);
                const isAccepted = acceptedList.some(app => app.isMe);
                const myRank = applicants.findIndex(app => app.isMe) + 1;
                const cutoffMileage = acceptedList[acceptedList.length - 1].mileage;

                // Determine Reason Wording if Success (마일리지 값, 전공여부, 학년, 랜덤추첨)
                let reasonText = '-';
                if (isAccepted) {
                    if (myBet >= cutoffMileage) {
                        // 마일리지 우위를 주로 배정 사유로 설정
                        reasonText = "마일리지 값";
                    } else {
                        // 그 외 성공 건은 2~4번 사유 중 무작위 선택
                        const otherReasons = ["전공여부", "학년", "랜덤추첨"];
                        const randIdx = Math.floor(Math.random() * otherReasons.length);
                        reasonText = otherReasons[randIdx];
                    }
                } else {
                    reasonText = "마일리지/우선순위 미달 탈락";
                }

                return {
                    course,
                    myBet,
                    cutoffMileage,
                    isAccepted,
                    myRank,
                    totalApplicants: applicants.length,
                    reasonText
                };
            });

            renderFinalResults();
            switchTab('result');
            showAlert('마감 시뮬레이션 완료', '수강신청 마감 처리가 완료되었습니다. 최종 결과를 확인하세요!', 'fa-flag-checkered text-kuGold');
        }

        function renderFinalResults() {
            const notice = document.getElementById('unfinalizedNotice');
            const container = document.getElementById('finalizedResultContainer');
            const tbody = document.getElementById('resultTableBody');

            if (!isFinalized || !finalResults) {
                notice.classList.remove('hidden');
                container.classList.add('hidden');
                return;
            }

            notice.classList.add('hidden');
            container.classList.remove('hidden');
            tbody.innerHTML = '';

            finalResults.forEach(res => {
                const tr = document.createElement('tr');
                tr.className = "border-b border-gray-200 hover:bg-gray-50";

                const badge = res.isAccepted 
                    ? `<span class="px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 border border-emerald-300"><i class="fa-solid fa-circle-check"></i> 수강 성공</span>`
                    : `<span class="px-3 py-1 rounded-full text-xs font-bold bg-red-100 text-red-800 border border-red-300"><i class="fa-solid fa-circle-xmark"></i> 수강 실패</span>`;

                tr.innerHTML = `
                    <td class="p-3 font-bold text-gray-800">
                        ${res.course.name}
                        <div class="text-[10px] text-gray-400 font-mono">${res.course.id}</div>
                    </td>
                    <td class="p-3"><span class="px-2 py-0.5 rounded text-[10px] font-bold ${res.course.type === '전공' ? 'bg-blue-100 text-blue-700' : 'bg-purple-100 text-purple-700'}">${res.course.type}</span></td>
                    <td class="p-3 font-bold text-kuGreen">${res.myBet} M</td>
                    <td class="p-3 font-mono text-gray-600">${res.cutoffMileage} M</td>
                    <td class="p-3 text-center">${badge}</td>
                    <td class="p-3 text-xs font-medium ${res.isAccepted ? 'text-emerald-700' : 'text-gray-400'}">${res.reasonText}</td>
                `;
                tbody.appendChild(tr);
            });
        }
    </script>
</body>
</html>
