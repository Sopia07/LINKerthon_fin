        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        kuGreen: {
                            light: '#1e5e3a',
                            DEFAULT: '#004B23',
                            dark: '#003318',
                        },
                        kuGold: {
                            DEFAULT: '#D4AF37',
