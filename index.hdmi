        ];

        // Global State
        let currentUser = null;
        let activeTab = 'wishlist'; // 'wishlist', 'allCourses', 'timetable', 'history', 'result'
        let wishlist = []; // Stores { courseId, mileage }
        let timerSeconds = 62 * 60; // 1 hour 2 mins (3720 seconds)
        let timerInterval = null;
        let isFinalized = false; // Is evaluation completed
        let finalResults = null; // Store calculated final results

        // Helper: Convert Time string "월09:00-10:30,수09:00-10:30" to parsed slots
        function parseCourseTime(timeStr) {
            const slots = [];
            const parts = timeStr.split(',');
            parts.forEach(p => {
                const day = p.substring(0, 1); // e.g. '월'
                const times = p.substring(1).split('-'); // ['09:00', '10:30']
                if(times.length === 2) {
                    const start = times[0];
                    const end = times[1];
                    slots.push({ day, start, end });
                }
            });
            return slots;
        }

        // Convert HH:MM to minute value from midnight
        function timeToMinutes(t) {
            const [h, m] = t.split(':').map(Number);
            return h * 60 + m;
        }

        // Check time overlap between two time slot arrays
        function isTimeOverlapping(slots1, slots2) {
            for (let s1 of slots1) {
                for (let s2 of slots2) {
                    if (s1.day === s2.day) {
                        const start1 = timeToMinutes(s1.start);
                        const end1 = timeToMinutes(s1.end);
                        const start2 = timeToMinutes(s2.start);
                        const end2 = timeToMinutes(s2.end);

                        // Overlap condition: start1 < end2 && start2 < end1
                        if (start1 < end2 && start2 < end1) {
                            return true;
                        }
                    }
                }
            }
            return false;
        }

        // Notification Modal Helper
        function showAlert(title, message, iconClass = "fa-triangle-exclamation text-amber-500") {
            const modal = document.getElementById('customModal');
            document.getElementById('modalTitle').innerText = title;
            document.getElementById('modalMessage').innerText = message;
            document.getElementById('modalIcon').className = `fa-solid ${iconClass} text-3xl mb-3`;
            modal.classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('customModal').classList.add('hidden');
        }
    </script>

    <!-- Top Header Bar -->
    <header class="bg-kuGreen text-white shadow-md sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 py-3 flex flex-wrap justify-between items-center gap-4">
            <!-- Brand Logo -->
            <div class="flex items-center space-x-3">
                <div class="bg-white text-kuGreen font-bold p-2 rounded-lg text-xl tracking-wider shadow">
                    <i class="fa-solid fa-graduation-cap text-kuGold"></i> KU
                </div>
                <div>
                    <h1 class="font-bold text-lg leading-tight">건국대학교 수강신청</h1>
                    <p class="text-xs text-green-200">마일리지 할당 수강신청 시스템</p>
                </div>
            </div>

            <!-- Header Middle/Right Stats & Countdown -->
            <div id="headerUserInfo" class="hidden flex flex-wrap items-center gap-4">
                <!-- User Profile Summary -->
                <div class="bg-kuGreen-dark px-3 py-1.5 rounded-lg border border-green-700 text-xs flex items-center gap-3">
                    <div>
                        <span class="font-bold text-sm text-kuGold" id="userDisplayName">-</span>
                        <span class="text-gray-300"> (<span id="userDisplayDept">-</span> / <span id="userDisplayGrade">-</span>학년)</span>
                    </div>
                    <span id="earlyGradBadge" class="hidden bg-amber-500 text-white text-[10px] px-1.5 py-0.5 rounded font-bold">조기졸업대상</span>
                </div>

                <!-- Mileage Summary Wallet -->
                <div class="bg-white text-gray-800 px-3 py-1.5 rounded-lg font-medium text-xs shadow flex items-center gap-2">
                    <i class="fa-solid fa-wallet text-amber-500 text-sm"></i>
                    <span>지갑: <strong id="headerRemainingMileage" class="text-kuGreen text-sm">0</strong> / <span id="headerTotalMileage">0</span> M</span>
                </div>

                <!-- Timer -->
                <div class="bg-red-900/80 border border-red-500 text-white px-3 py-1.5 rounded-lg flex items-center gap-2 text-xs">
                    <i class="fa-regular fa-clock animate-pulse text-red-300"></i>
                    <span>남은시간: <strong id="countdownTimer" class="font-mono text-sm text-yellow-300">01:02:00</strong></span>
                    <span id="blindNoticeTag" class="hidden text-[10px] bg-red-600 px-1 rounded text-white font-bold ml-1">블라인드</span>
                </div>

                <!-- Simulation Action Controls -->
                <div class="flex items-center gap-1.5">
                    <button onclick="skipTimerToOneHour()" class="text-xs bg-amber-600 hover:bg-amber-700 text-white px-2.5 py-1.5 rounded transition shadow" title="테스트용: 1시간 이하로 시간을 넘겨 블라인드 상태를 테스트합니다.">
                        <i class="fa-solid fa-forward text-xs"></i> 1시간전 타임스킵
                    </button>
                    <button onclick="finalizeRegistration()" class="text-xs bg-kuGold hover:bg-yellow-500 text-gray-900 font-bold px-3 py-1.5 rounded transition shadow">
                        <i class="fa-solid fa-flag-checkered"></i> 마감 시뮬레이션
                    </button>
                    <button onclick="logout()" class="text-xs bg-gray-700 hover:bg-gray-800 text-white px-2.5 py-1.5 rounded transition">
                        <i class="fa-solid fa-right-from-bracket"></i> 로그아웃
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- MAIN CONTENT AREA -->
    <main class="flex-1 max-w-7xl w-full mx-auto p-4">
        <!-- LOGIN SECTION -->
        <div id="loginSection" class="max-w-md mx-auto my-12 bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-100">
            <div class="bg-kuGreen p-6 text-white text-center relative">
                <div class="w-16 h-16 bg-white rounded-full flex items-center justify-center text-kuGreen text-3xl font-bold mx-auto mb-2 shadow-lg">
                    <i class="fa-solid fa-university text-kuGreen"></i>
                </div>
                <h2 class="text-2xl font-bold">수강신청 시스템 로그인</h2>
                <p class="text-xs text-green-200 mt-1">건국대학교 마일리지 배팅 수강신청 서비스</p>
            </div>
            
            <div class="p-6 space-y-4">
                <!-- Preset Student Selector for Easy Demo -->
                <div class="bg-green-50 p-3 rounded-lg border border-green-200 text-xs">
                    <label class="block font-bold text-kuGreen mb-1">
                        <i class="fa-solid fa-user-check"></i> 테스트용 학생 프로필 선택
                    </label>
                    <select id="presetSelect" onchange="loadPresetStudent()" class="w-full p-2 border rounded bg-white text-gray-700 font-medium">
                        <option value="">-- 로그인할 학생을 선택하세요 --</option>
                        <option value="202611001">1학년 컴퓨터공학과 김소현 (18학점 / 1800M)</option>
                        <option value="202511002">2학년 뷰티화장품학과 윤현호 (18학점 / 1800M)</option>
                        <option value="202411003">3학년 경찰학과 안준철 (21학점 / 2100M - 조기졸업)</option>
                        <option value="202311004">4학년 간호학과 배기정 (18학점 / 1800M)</option>
                    </select>
                </div>

                <form onsubmit="handleLogin(event)" class="space-y-3">
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">학교</label>
                        <input type="text" value="건국대학교" readonly class="w-full p-2.5 bg-gray-100 border border-gray-300 rounded text-sm text-gray-600">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">학번</label>
                        <input type="text" id="loginId" placeholder="학번 입력" required class="w-full p-2.5 border border-gray-300 rounded focus:ring-2 focus:ring-kuGreen focus:outline-none text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">비밀번호</label>
                        <input type="password" id="loginPass" value="1234" placeholder="비밀번호" required class="w-full p-2.5 border border-gray-300 rounded focus:ring-2 focus:ring-kuGreen focus:outline-none text-sm">
                    </div>
                    <button type="submit" class="w-full py-3 bg-kuGreen hover:bg-kuGreen-dark text-white font-bold rounded-lg shadow transition duration-200 text-sm">
                        로그인
                    </button>
                </form>
            </div>
        </div>

        <!-- APP DASHBOARD (Hidden by Default) -->
        <div id="appDashboard" class="hidden space-y-4">
            
            <!-- Navigation Tabs -->
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-1.5 flex flex-wrap gap-1">
